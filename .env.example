# Stringa di connessione al database PostgreSQL.
# Su Supabase: Project Settings > Database > Connection string > URI
# Sostituisci [YOUR-PASSWORD] con la password del database.
DATABASE_URL=postgresql://utente:password@host:5432/nome_db

# Chiave con cui il server firma i token JWT: inventane una lunga e casuale,
# almeno 40 caratteri. Chi la conosce può generare token validi per chiunque.
JWT_SECRET=stringa_lunga_e_casuale_di_almeno_quaranta_caratteri